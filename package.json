{
  "name": "mory-markdown-editor",
  "version": "0.3.0",
  "author": "Mory Contributors",
  "private": true,
  "description": "A cross-platform Markdown editor combining native desktop hosts with a shared web editor",
  "main": "Electron/main.cjs",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "predev": "npm run build:web",
    "dev": "electron .",
    "test": "node --test --experimental-test-coverage",
    "check:language": "node scripts/check-development-language.mjs",
    "pretest:mac-web": "npm run build:web",
    "test:mac-web": "bash scripts/test-macos-web.sh",
    "pretest:mac-typing": "npm run build:web",
    "test:mac-typing": "bash scripts/test-macos-typing.sh",
    "test:mac-ime": "bash scripts/test-macos-ime.sh",
    "pretest:mac-graph": "npm run build:web",
    "test:mac-graph": "bash scripts/test-macos-graph.sh",
    "test:mac-drag": "bash scripts/test-macos-drag.sh",
    "test:mac-workspace-watcher": "bash scripts/test-macos-workspace-watcher.sh",
    "test:mac-menu-localization": "bash scripts/test-macos-menu-localization.sh",
    "test:mac-launch-request": "bash scripts/test-macos-launch-request.sh",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "electron Tests/electron-export.cjs && electron Tests/button-interactions.cjs",
    "precheck": "npm run build:web",
    "check": "npm run check:language && node scripts/build-web.mjs --check && node --check Electron/main.cjs && node --check Electron/preload.cjs && node --check Electron/workspaces.cjs && node --check Electron/workspace-watcher.cjs && node --check Electron/themes.cjs && node --check Sources/Mory/Web/app.js && node --check Sources/Mory/Web/editor-features.js && node --check Sources/Mory/Web/markdown.js && node --check Sources/Mory/Web/knowledge.js && node --check Sources/Mory/Web/app.bundle.js && node --check Tests/electron-export.cjs && node --check Tests/button-interactions.cjs && node --check Tests/host-regressions.test.cjs && node --check Tests/workspaces.test.cjs && node --check Tests/workspace-watcher.test.cjs && node --check Tests/knowledge.test.js",
    "prebuild:mac": "npm run build:web",
    "build:mac": "bash scripts/build-macos.sh",
    "dist:mac": "bash scripts/package-macos-release.sh",
    "prepack:mac:electron": "npm run build:web",
    "pack:mac:electron": "electron-builder --mac dmg --publish never",
    "prepack:win": "npm run build:web",
    "pack:win": "electron-builder --win nsis portable --x64 --publish never",
    "prepack:win:portable": "npm run build:web",
    "pack:win:portable": "electron-builder --win portable --x64 --publish never",
    "prepack:win:arm64": "npm run build:web",
    "pack:win:arm64": "electron-builder --win nsis portable --arm64 --publish never"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "d3": "7.9.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.12",
    "mermaid": "11.16.1"
  },
  "build": {
    "appId": "io.mory.editor",
    "productName": "Mory",
    "asar": true,
    "files": [
      "Electron/**/*",
      "Sources/Mory/Web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/storage",
        "to": "storage",
        "filter": [
          "mory-storage",
          "mory-storage.exe"
        ]
      }
    ],
    "directories": {
      "output": "dist/windows"
    },
    "win": {
      "icon": "assets/mory-icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Mory-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/mory-icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "Mory-Electron-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Mory-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mory"
    },
    "portable": {
      "artifactName": "Mory-Portable-${version}-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mmd",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "pangu": "9.1.0"
  }
}
